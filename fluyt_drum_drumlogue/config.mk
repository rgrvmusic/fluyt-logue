##############################################################################
# Fluyt - the DRUM unit. GENERATED by tools/gen_rows.c: edit the generator.
#
# Felucca's eng_drum.c (ENG_DRUM, engine 10 of its ENGINES[]) and the panel of
# fluyt_drum_drumlogue/rows.def. The Makefile next to this file is the logue SDK's own, unmodified.
##############################################################################

PROJECT      := fluyt_drum
PROJECT_TYPE := synth

SHIM_PATH    ?= $(PROJECT_ROOT)../shim
FELUCCA_PATH ?= $(PROJECT_ROOT)../felucca

CSRC  = $(SHIM_PATH)/fluyt_header.c
CSRC += $(SHIM_PATH)/fluyt_engine.c
CSRC += $(SHIM_PATH)/fluyt_unit.c

UINCDIR  = $(SHIM_PATH)
UINCDIR += $(SHIM_PATH)/gen
UINCDIR += $(FELUCCA_PATH)/firmware/src

ULIBDIR =

# the drumlogue is an ordinary Linux: libc is real here (Felucca's own libc.c is not
# compiled in, see shim/fluyt_fmt.h), and -lm for the float conversion
ULIBS  = -lm
ULIBS += -lc

# Felucca's own flags (tools/build.py: -Os -ffunction-sections -fno-builtin), and the three
# that make its fixed-point arithmetic portable to a second toolchain: the FM-1's char is
# signed, its arithmetic wraps, and its DSP puns types (so no strict aliasing)
USE_OPT  := -Os -ffunction-sections -fno-builtin
USE_COPT := -fsigned-char -fwrapv -fno-strict-aliasing

# Felucca's files are each one compilation unit of its own, with more in them than one
# engine calls (tools/build.py compiles them the same way)
USE_CWARN := -W -Wall -Wextra -Wno-unused-function -Wno-unused-variable

UDEFS  = -DFLUYT_ENGINE_C=\"eng_drum.c\"
UDEFS += -DFLUYT_ENGINE_SYM=ENG_DRUM
UDEFS += -DFLUYT_ENGINE_INDEX=10
UDEFS += -DFLUYT_ROWS=\"rows.def\"
# the name has a space in it, and a -D goes through the shell unquoted: the backslash
# keeps the compiler seeing one word, the escaped quotes make it a C string
UDEFS += -DFLUYT_UNIT_NAME=\"FLUYT\ DRUM\"
UDEFS += -DFLUYT_UNIT_ID=0x464C5908U
UDEFS += -DFLUYT_UNIT_PRESETS=1
UDEFS += -DFLUYT_GATE_NOTE=36
# what this engine has of itself: it reads m->cutoff / m->shape (see UNITS[] in the
# generator). tools/check_rows.c holds the panel to these two - a filter row or an LFO
# filter amount where there is no filter is a slot spent on nothing.
UDEFS += -DFLUYT_ENGINE_CUTOFF=0
UDEFS += -DFLUYT_ENGINE_SHAPE=0
