##############################################################################
# Fluyt - the LOFI unit. GENERATED by tools/gen_rows.c: edit the generator.
#
# Felucca's eng_lofi.c (ENG_LOFI, engine 3 of its ENGINES[]) and the panel of
# fluyt_lofi_microkorg2/rows.def. The Makefile next to this file is the logue SDK's own, unmodified.
##############################################################################

PROJECT      := fluyt_lofi
PROJECT_TYPE := osc

SHIM_PATH    ?= $(PROJECT_ROOT)../shim
FELUCCA_PATH ?= $(PROJECT_ROOT)../felucca

CSRC  = $(SHIM_PATH)/fluyt_microkorg2_header.c
CSRC += $(SHIM_PATH)/fluyt_engine.c
CSRC += $(SHIM_PATH)/fluyt_microkorg2_unit.c

UINCDIR  = $(SHIM_PATH)
UINCDIR += $(SHIM_PATH)/gen
UINCDIR += $(FELUCCA_PATH)/firmware/src

ULIBDIR =

# the microKORG2 is an ordinary Linux: libc is real here (Felucca's own libc.c is not
# compiled in, see shim/fluyt_fmt.h), and -lm for the float conversion
ULIBS  = -lm
ULIBS += -lc

# Felucca's own flags (tools/build.py: -Os -ffunction-sections -fno-builtin), and the three
# that make its fixed-point arithmetic portable to a second toolchain: the FM-1's char is
# signed, its arithmetic wraps, and its DSP puns types (so no strict aliasing)
USE_OPT  := -Os -ffunction-sections -fno-builtin
USE_COPT := -fsigned-char -fwrapv -fno-strict-aliasing

# Felucca's files are each one compilation unit of its own, with more in them than one
# engine calls (tools/build.py compiles them the same way)
USE_CWARN := -W -Wall -Wextra -Wno-unused-function -Wno-unused-variable

UDEFS  = -DFLUYT_ENGINE_C=\"eng_lofi.c\"
UDEFS += -DFLUYT_ENGINE_SYM=ENG_LOFI
UDEFS += -DFLUYT_ENGINE_INDEX=3
UDEFS += -DFLUYT_ROWS=\"rows.def\"
# this build is the microKORG2's: the bridge renders one voice per lane (shim/fluyt_microkorg2.c),
# the envelope is held open rather than shown, and the panel is 13 rows (rows.def)
UDEFS += -DFLUYT_TARGET_MICROKORG2
# the name the instrument shows: 8 characters at most (UNIT_NAME_LEN), and it is the
# unit's own - see UNITS[] in the generator
UDEFS += -DFLUYT_UNIT_NAME=\"F-LOFI\"
UDEFS += -DFLUYT_UNIT_ID=0x464C5904U
UDEFS += -DFLUYT_UNIT_PRESETS=5
UDEFS += -DFLUYT_GATE_NOTE=60
# what this engine has of itself: it reads m->cutoff / m->shape (see UNITS[] in the
# generator). The shape decides a row here and tools/check_rows_microkorg2.c holds
# it to that (P_LD_SHP, the walk's one conditional row). The cutoff decides none: this
# panel's walk has no filter row at all - no P_LD_FLT, and none of this engine's own rows
# reads m->cutoff - so the flag is the same fact about the engine, written for the panel
# that does have one.
UDEFS += -DFLUYT_ENGINE_CUTOFF=1
UDEFS += -DFLUYT_ENGINE_SHAPE=0
# and whether the track's ADSR is this engine's amplitude: FM6's operator envelopes are
# (ownenv), DRUM's hit is (oneshot), and both hold the ADSR at full. Neither is a row here:
# the whole envelope group is off this panel and the bridge holds Felucca's ADSR open in its
# place (shim/fluyt_microkorg2.c). Both flags are still read: tools/check_rows_microkorg2.c
# holds them to the engine descriptor the unit renders with, and the drumlogue panel's own
# render check reads the same fact about the same engine.
UDEFS += -DFLUYT_ENGINE_OWNENV=0
UDEFS += -DFLUYT_ENGINE_ONESHOT=0
# and the row of this engine's own that can mask the envelope's filter amount: LOFI's TONE
# saturates its own lowpass at its default, so the FLT row only opens anything below it.
# This panel has no envelope filter row to mask, so nothing
# here reads it: the same fact about the engine, and empty where there is no such row (see
# UNITS[] in the generator).
UDEFS += -DFLUYT_ENGINE_TONE=P_E7
